# --- Server (backend/.env) ---
# All backend settings load from this file via dotenv. Never commit .env.

PORT=4000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h

# Comma-separated browser origins. Never use "*".
# Local Vite is always allowed when NODE_ENV != production.
# Production: set to your live URL, e.g. https://diu-english-smartroutine.onrender.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Built frontend folder for combined deploy (Render sets this to backend/public)
# WEB_DIST=backend/public

# --- Email ---
SMTP_USER=your.name@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your.name@gmail.com
MAIL_FROM_NAME=DIU SmartRoutine

# Optional public portal link inside emails
# PUBLIC_APP_URL=https://your-app.onrender.com
# APP_URL=https://your-app.onrender.com

# MAIL_HTTP_DISABLED=1
# RESEND_API_KEY=
# BREVO_API_KEY=

# --- Web Push ---
# Generate: cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# --- Google Calendar (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
PUBLIC_APP_URL=http://localhost:5173

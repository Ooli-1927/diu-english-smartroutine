# --- Frontend (frontend/.env) ---
# Vite only exposes variables prefixed with VITE_. Never commit .env.

# Local development: leave VITE_API_URL unset — Vite proxies /api → VITE_API_TARGET
VITE_API_TARGET=http://127.0.0.1:4000

# Production / separate API host (usually unset on Render — same origin /api):
# VITE_API_URL=https://your-app.onrender.com/api

# Optional Supabase fallback when live API is unreachable
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

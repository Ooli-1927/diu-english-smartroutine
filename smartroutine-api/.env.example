# --- Server ---
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
# Comma-separated allowed browser origins. Never use "*".
# In development, localhost:5173 / 127.0.0.1:5173 are always allowed when NODE_ENV != production.
# In production, set this to your real frontend origin(s), e.g. https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: folder of built React app (default: ../smartroutine-web/dist)
# WEB_DIST=

# --- Email ---
# Best: Gmail App Password (professional HTML From your address).
# Or save once in the app: Chairman â†’ Profile â†’ Professional email.
#
# Google Account â†’ Security â†’ 2-Step Verification ON â†’ App passwords
# â†’ Mail â†’ copy 16-character password into SMTP_PASS (or the Profile form).

SMTP_USER=your.name@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your.name@gmail.com
MAIL_FROM_NAME=DIU SmartRoutine

# Optional public portal link inside emails (skip localhost)
# PUBLIC_APP_URL=https://your-app.onrender.com
# APP_URL=https://your-app.onrender.com

# MAIL_HTTP_DISABLED=1
# RESEND_API_KEY=
# BREVO_API_KEY=

# --- Web Push (browser notifications) ---
# Generate a key pair (do not commit real keys):
#   cd smartroutine-api && npx web-push generate-vapid-keys
# Paste the Public Key / Private Key below. Subject should be a mailto: or https: URL.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# --- Google Calendar one-way sync (SmartRoutine → Google) ---
# Create an OAuth Web client in Google Cloud Console (see SETUP.md).
# Leave blank to disable Connect Google Calendar (app + .ics export still work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Where OAuth callback sends the browser after connect (Vite in local dev):
PUBLIC_APP_URL=http://localhost:5173

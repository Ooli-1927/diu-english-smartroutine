{
  "name": "smartroutine-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API + SQLite database for the SmartRoutine (DIU English Routine) web app",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/index.js",
    "dev": "node --experimental-sqlite --watch src/index.js",
    "seed": "node --experimental-sqlite src/seed.js",
    "reset": "node --experimental-sqlite src/seed.js --force"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.13",
    "web-push": "^3.6.7"
  }
}
